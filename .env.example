# Create a Notion internal integration and copy its secret here.
NOTION_TOKEN=secret_replace_me
# ID of the Notion database shared with your integration.
NOTION_DATABASE_ID=replace_with_database_id
# Notion API 2025-09-03 supports databases with multiple data sources.
NOTION_VERSION=2025-09-03
# Optional: set when the database has multiple data sources.
NOTION_DATA_SOURCE_ID=
